# Optional remote dashboard password (at least 12 characters).
# No .env is loaded automatically. Export LAB_REMOTE_PASSWORD in your shell,
# or let --host 0.0.0.0 create a private .remote-access-password file.
# Printer reads always use a mock; no printer address is needed.
LAB_REMOTE_PASSWORD=
# Model compilation uses the locally installed native Linux executable.
# Export settings in the shell before startup; this file is not auto-loaded.
# Omit OPENSCAD_BIN to search PATH. An invalid explicit value is reported.
OPENSCAD_BIN=/usr/bin/openscad
# Optional. Default: lab-agents/results/models (ignored local artifacts).
# OPENSCAD_JOBS_DIR=/absolute/private/path/to/model-jobs
# Optional AI generation. Export these in the backend shell before startup.
# Leave the key empty here; use app.py --prompt-groq-key for hidden terminal entry.
# Missing credentials disable AI generation only, not manual compilation/status.
MODEL_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
