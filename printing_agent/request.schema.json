{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhotonicsAI Printer Agent delegation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "specialist", "task_id", "request"],
  "properties": {
    "version": {"const": 1, "type": "integer"},
    "specialist": {"const": "3d-printing"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "request": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["command"], "properties": {"command": {"const": "describe"}}},
      {"type": "object", "additionalProperties": false, "required": ["command"], "properties": {
        "command": {"enum": ["status", "position", "capabilities", "stop"]}, "id": {"$ref": "#/definitions/id"}
      }},
      {"type": "object", "additionalProperties": false, "required": ["command", "job_id"], "properties": {
        "command": {"const": "job"}, "job_id": {"type": "string"}, "id": {"$ref": "#/definitions/id"}
      }},
      {"type": "object", "additionalProperties": false, "required": ["command", "target"], "properties": {
        "command": {"const": "move"}, "target": {"$ref": "#/definitions/target"},
        "speed_mm_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
        "preview": {"type": "boolean"}, "token": {"type": "string"}, "id": {"$ref": "#/definitions/id"}
      }, "allOf": [{"$ref": "#/definitions/tokenRule"}]},
      {"type": "object", "additionalProperties": false, "required": ["command"], "properties": {
        "command": {"const": "home"}, "axes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["x", "y", "z"]}},
        "preview": {"type": "boolean"}, "token": {"type": "string"}, "id": {"$ref": "#/definitions/id"}
      }, "allOf": [{"$ref": "#/definitions/tokenRule"}]}
    ]},
    "operator_approval": {
      "type": "object", "additionalProperties": false, "required": ["confirmed", "clear_path"],
      "properties": {"confirmed": {"type": "boolean"}, "clear_path": {"type": "boolean"}}
    }
  },
  "allOf": [
    {"if": {"required": ["operator_approval"]}, "then": {"properties": {"request": {
      "required": ["preview"], "properties": {"command": {"enum": ["move", "home"]}, "preview": {"const": false}}
    }}}},
    {"if": {"properties": {"request": {"required": ["preview"], "properties": {"preview": {"const": false}}}}},
     "then": {"required": ["operator_approval"]}}
  ],
  "definitions": {
    "id": {"type": ["string", "integer"]},
    "target": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}
    },
    "tokenRule": {
      "if": {"required": ["preview"], "properties": {"preview": {"const": false}}},
      "then": {"required": ["token"]},
      "else": {"not": {"required": ["token"]}}
    }
  }
}
